# ---------------------------------------------------------------------------
# Belzo eMart — production env for the single-host Docker stack.
# Copy to .env.prod on the server and fill in real values. NEVER commit .env.prod.
# ---------------------------------------------------------------------------

# Public URL browsers use. EC2 public IP now; switch to https://your-domain later.
PUBLIC_BASE_URL=http://13.48.85.9

# --- PostgreSQL (container) ---
POSTGRES_USER=belzo
POSTGRES_PASSWORD=CHANGE_ME_use_a_strong_password
POSTGRES_DB=belzo

# --- API runtime ---
NODE_ENV=production
# Host is the compose service name "postgres". Keep the password in sync with POSTGRES_PASSWORD.
DATABASE_URL=postgresql://belzo:CHANGE_ME_use_a_strong_password@postgres:5432/belzo?schema=public
REDIS_URL=redis://redis:6379

# Must be at least 32 characters each. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_min_32_chars_access_secret_xxxxxxxx
JWT_REFRESH_SECRET=CHANGE_ME_min_32_chars_refresh_secret_yyyyyyyy
# Delivery module (U8): partner token secret (must differ from the two above) and delivery OTP pepper.
JWT_PARTNER_SECRET=CHANGE_ME_min_32_chars_partner_secret_zzzzzzzz
DELIVERY_OTP_PEPPER=CHANGE_ME_min_32_chars_delivery_otp_pepper_

# Comma-separated allowlist — must include your public origin.
CORS_ORIGINS=http://13.48.85.9

# Seed super-admin (used only when you run the seed).
SEED_ADMIN_EMAIL=admin@belzo.local
SEED_ADMIN_PASSWORD=CHANGE_ME_admin_password

# --- Integrations (mock by default; set to "live" and fill keys for production) ---
PAYMENT_PROVIDER=mock
SHIPPING_PROVIDER=mock
SMS_PROVIDER=mock
# Fast2SMS (used when SMS_PROVIDER=live). API key: Fast2SMS dashboard > Dev API. Never commit the real key.
# FAST2SMS_ROUTE: "otp" = Fast2SMS OTP route ("Your OTP: 123456"); "dlt" = your DLT template (needs the two ids below).
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=otp
FAST2SMS_SENDER_ID=
FAST2SMS_DLT_MESSAGE_ID=
# FAST2SMS_ROUTE=smart sends through your linked Smart OTP template; set its id here (Fast2SMS > Smart OTP).
FAST2SMS_OTP_ID=
WHATSAPP_PROVIDER=mock
EMAIL_PROVIDER=mock

# --- Object storage ---
# "local" stores uploads on the API container's disk (belzo-uploads volume),
# served at <PUBLIC_BASE_URL>/api/uploads/<key>. "s3" uploads to the bucket below.
STORAGE_PROVIDER=local
# To use S3:
#   1. Create a bucket and an IAM user (or attach an EC2 instance role) with
#      s3:PutObject on that bucket.
#   2. For images to display in the browser, objects must be publicly readable
#      (bucket policy allowing s3:GetObject), or front the bucket with CloudFront
#      and set CDN_BASE_URL to the distribution domain.
#   3. Set STORAGE_PROVIDER=s3 and fill the values below.
# S3_REGION=eu-north-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Optional CDN in front of the bucket (CloudFront). If set, image URLs use it.
# CDN_BASE_URL=

# Razorpay — to accept real payments:
#   1. Set PAYMENT_PROVIDER=live (above).
#   2. Fill the three keys below (Razorpay Dashboard → Settings → API Keys).
#      RAZORPAY_KEY_ID looks like rzp_live_xxxx; the secret is shown once at creation.
#   3. PUBLIC_BASE_URL (top of this file) MUST be https:// — Razorpay live and the
#      mobile app's hosted checkout call back to it.
#   4. Add a webhook in the Razorpay Dashboard (Settings → Webhooks) pointing to:
#        <PUBLIC_BASE_URL>/api/v1/payments/webhook
#      subscribe to payment.authorized, payment.captured, payment.failed and order.paid,
#      and set the webhook secret to RAZORPAY_WEBHOOK_SECRET below (any long random string,
#      e.g. `openssl rand -hex 24`).
# Orders are confirmed even before the webhook is set up (the app/browser asks the server,
# which asks Razorpay), but the webhook is the safety net for customers who close the page
# right after paying. The admin API GET /api/v1/admin/payment-gateway/status shows whether
# Razorpay has ever called the webhook.
# The API refuses to boot with PAYMENT_PROVIDER=live if any key is blank.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

LOG_LEVEL=info

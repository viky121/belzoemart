# Belzo eMart reverse proxy.
#
# CURRENT: plain HTTP on port 80 (works with a raw EC2 public IP).
# Requests to /api/* go to the NestJS API; everything else to the Next.js web.
:80 {
	encode zstd gzip

	@api path /api/*
	reverse_proxy @api api:4000

	reverse_proxy web:3000
}

# ---------------------------------------------------------------------------
# WHEN YOU HAVE A DOMAIN (auto-HTTPS via Let's Encrypt):

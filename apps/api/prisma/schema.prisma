// Belzo eMart — Prisma schema (U1 platform-core baseline).
// Domain models (customers, products, orders, ...) are added by their units
// (U2–U7). This baseline sets datasource/generator and a HealthProbe table
// used by readiness checks and to validate migrations end-to-end.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Simple table used to confirm DB connectivity and migration wiring.
model HealthProbe {
  id        String   @id @default(uuid())
  note      String   @default("ok")
  createdAt DateTime @default(now())

  @@map("health_probe")
}

// ===========================================================================
// U2 identity — customers, admins, RBAC, sessions, OTP, DPDP
// ===========================================================================

enum CustomerStatus {
  active
  blocked
}

enum AdminStatus {
  active
  disabled
}

enum AddressLabel {
  home
  work
  other
}

enum PrincipalKind {
  customer
  admin
  partner
}

enum DataRequestType {
  export
  deletion
}

enum DataRequestStatus {
  pending
  processing
  completed
}

model Customer {
  id           String         @id @default(uuid())
  phone        String?        @unique
  email        String?        @unique
  passwordHash String?
  name         String
  gender       String?
  dob          DateTime?
  photoUrl     String?
  locale       String         @default("en")
  status       CustomerStatus @default(active)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  addresses    Address[]
  dataRequests DataRequest[]

  @@map("customers")
}

model Address {
  id         String       @id @default(uuid())
  customerId String
  label      AddressLabel @default(home)
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  pincode    String
  isDefault  Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("addresses")
}

model AdminUser {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  name         String
  mfaSecret    String?
  mfaEnabled   Boolean     @default(false)
  status       AdminStatus @default(active)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  roles AdminUserRole[]

  @@map("admin_users")
}

model Role {
  id          String @id @default(uuid())
  name        String @unique
  description String @default("")

  permissions RolePermission[]
  admins      AdminUserRole[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  key         String @unique
  description String @default("")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AdminUserRole {
  adminUserId String
  roleId      String

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminUserId, roleId])
  @@map("admin_user_roles")
}

model RefreshToken {
  id            String        @id @default(uuid())
  principalId   String
  principalKind PrincipalKind
  tokenHash     String        @unique
  familyId      String
  expiresAt     DateTime
  revokedAt     DateTime?
  replacedById  String?
  createdAt     DateTime      @default(now())

  @@index([principalId, principalKind])
  @@index([familyId])
  @@map("refresh_tokens")
}

model OtpRequest {
  id          String    @id @default(uuid())
  email       String?
  phone       String?
  codeHash    String
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([phone])
  @@map("otp_requests")
}

model LoginAttempt {
  id         String        @id @default(uuid())
  identifier String
  kind       PrincipalKind
  succeeded  Boolean
  ip         String?
  createdAt  DateTime      @default(now())

  @@index([identifier, createdAt])
  @@map("login_attempts")
}

model DataRequest {
  id          String            @id @default(uuid())
  customerId  String
  type        DataRequestType
  status      DataRequestStatus @default(pending)
  resultUrl   String?
  createdAt   DateTime          @default(now())
  completedAt DateTime?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("data_requests")
}

// ===========================================================================
// U3 catalogue — categories, brands, attributes, products, variants, inventory
// ===========================================================================

enum ProductStatus {
  draft
  published
  archived
}

enum StockReason {
  purchase
  sale
  return_
  adjustment
  reserve
  release
}

model Category {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  parentId       String?
  imageUrl       String?
  displayOrder   Int      @default(0)
  seoTitle       String?
  seoDescription String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id       String    @id @default(uuid())
  name     String
  slug     String    @unique
  logoUrl  String?
  isActive Boolean   @default(true)
  products Product[]

  @@map("brands")
}

model Attribute {
  id     String           @id @default(uuid())
  name   String
  code   String           @unique
  type   String           @default("select")
  values AttributeValue[]

  @@map("attributes")
}

model AttributeValue {
  id          String             @id @default(uuid())
  attributeId String
  value       String
  attribute   Attribute          @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  products    ProductAttribute[]

  @@index([attributeId])
  @@map("attribute_values")
}

model Product {
  id             String        @id @default(uuid())
  title          String
  slug           String        @unique
  description    String        @default("")
  categoryId     String
  brandId        String?
  hsnCode        String        @default("")
  taxRatePct     Int           @default(0)
  status         ProductStatus @default(draft)
  isTaxInclusive Boolean       @default(true)
  isReturnable   Boolean       @default(true)
  videoUrl       String?
  ratingAvg      Float         @default(0)
  ratingCount    Int           @default(0)
  seoTitle       String?
  seoKeywords    String?
  seoDescription String?
  shgName        String?
  story          String?
  attributesJson Json          @default("{}")
  sku            String?       @unique // parent SKU from the bulk sheet; null for legacy products
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  category   Category           @relation(fields: [categoryId], references: [id])
  brand      Brand?             @relation(fields: [brandId], references: [id])
  images     ProductImage[]
  attributes ProductAttribute[]
  variants   Variant[]

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String
  alt       String  @default("")
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductAttribute {
  productId        String
  attributeValueId String
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([productId, attributeValueId])
  @@map("product_attributes")
}

model Variant {
  id             String   @id @default(uuid())
  productId      String
  sku            String   @unique
  mrp            Int
  sellingPrice   Int
  attributesJson Json     @default("{}")
  priceSlabsJson Json     @default("[]")
  imageUrl       String?
  weightGrams    Int      @default(0)
  weightValue    Float? // weight / pack size as entered by the admin
  weightUnit     String? // kg | gm | count | pc | litre | ml
  costPrice      Int? // purchase price, paise; ADMIN-ONLY
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory Inventory?

  @@index([productId])
  @@map("variants")
}

model Inventory {
  variantId    String   @id
  available    Int      @default(0)
  reserved     Int      @default(0)
  reorderLevel Int      @default(0)
  updatedAt    DateTime @updatedAt

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

model StockMovement {
  id        String      @id @default(uuid())
  variantId String
  delta     Int
  reason    StockReason
  ref       String?
  createdAt DateTime    @default(now())

  @@index([variantId, createdAt])
  @@map("stock_movements")
}

// ===========================================================================
// U4 cart-checkout — cart, coupons, payments, orders
// ===========================================================================

enum CouponKind {
  flat
  percent
  free_shipping
}

enum PaymentProviderKind {
  razorpay
  cod
  mock
}

enum PaymentStatus {
  created
  pending
  captured
  failed
  refunded
  partially_refunded
}

enum OrderStatus {
  pending
  confirmed
  packed
  shipped
  out_for_delivery
  delivered
  cancelled
  returned
}

model Cart {
  id         String     @id @default(uuid())
  customerId String?    @unique
  guestToken String?    @unique
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      CartItem[]

  @@map("carts")
}

model CartItem {
  id            String   @id @default(uuid())
  cartId        String
  variantId     String
  quantity      Int      @default(1)
  savedForLater Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

model Coupon {
  id           String     @id @default(uuid())
  code         String     @unique
  kind         CouponKind
  value        Int        @default(0)
  minOrder     Int        @default(0)
  maxDiscount  Int?
  usageLimit   Int?
  perUserLimit Int?
  categoryId   String?
  startsAt     DateTime   @default(now())
  endsAt       DateTime?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())

  redemptions CouponRedemption[]

  @@map("coupons")
}

model CouponRedemption {
  id         String   @id @default(uuid())
  couponId   String
  orderId    String
  customerId String
  createdAt  DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([customerId])
  @@map("coupon_redemptions")
}

model Order {
  id              String      @id @default(uuid())
  customerId      String
  addressId       String
  status          OrderStatus @default(pending)
  idempotencyKey  String      @unique
  couponCode      String?
  subtotal        Int
  discount        Int
  shipping        Int
  codFee          Int
  tax             Int
  cgst            Int
  sgst            Int
  igst            Int
  grandTotal      Int
  invoiceUrl      String?
  cancelledReason String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items        OrderItem[]
  payments     Payment[]
  shipments    Shipment[]
  invoice      Invoice?
  returns      ReturnRequest[]
  deliveryJobs DeliveryJob[]

  @@index([customerId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id         String @id @default(uuid())
  orderId    String
  variantId  String
  title      String
  sku        String
  unitPrice  Int
  quantity   Int
  taxRatePct Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id                String              @id @default(uuid())
  orderId           String
  provider          PaymentProviderKind
  providerOrderId   String?
  providerPaymentId String?
  amount            Int
  status            PaymentStatus       @default(created)
  method            String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

model WebhookEvent {
  id          String    @id @default(uuid())
  provider    String
  eventId     String    @unique
  payloadJson Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@map("webhook_events")
}

// ===========================================================================
// U5 orders-fulfilment — shipments, invoices, returns
// ===========================================================================

enum ShipmentStatus {
  created
  packed
  shipped
  out_for_delivery
  delivered
  cancelled
  rto
}

enum ReturnStatus {
  requested
  approved
  picked
  received
  refunded
  rejected
}

enum ReturnResolution {
  refund_source
  refund_wallet
  replace
}

model Shipment {
  id                String         @id @default(uuid())
  orderId           String
  provider          String         @default("mock")
  awb               String?
  courier           String?
  status            ShipmentStatus @default(created)
  trackingUrl       String?
  labelUrl          String?
  manifestUrl       String?
  estimatedDelivery DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events       TrackingEvent[]
  deliveryJobs DeliveryJob[]

  @@index([orderId])
  @@map("shipments")
}

model TrackingEvent {
  id          String   @id @default(uuid())
  shipmentId  String
  status      String
  description String
  location    String?
  occurredAt  DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("tracking_events")
}

model Invoice {
  id        String   @id @default(uuid())
  orderId   String   @unique
  number    String   @unique
  url       String
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model InvoiceCounter {
  year Int @id
  seq  Int @default(0)

  @@map("invoice_counters")
}

model ReturnRequest {
  id                String           @id @default(uuid())
  orderId           String
  customerId        String
  status            ReturnStatus     @default(requested)
  reason            String
  imagesJson        Json             @default("[]")
  pickupScheduledAt DateTime?
  resolution        ReturnResolution @default(refund_source)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  order Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items ReturnItem[]

  @@index([orderId])
  @@index([customerId])
  @@map("return_requests")
}

model ReturnItem {
  id              String @id @default(uuid())
  returnRequestId String
  orderItemId     String
  quantity        Int

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  @@index([returnRequestId])
  @@map("return_items")
}

// ===========================================================================
// U6 engagement — wishlist, reviews, Q&A, wallet, referrals, notifications, CMS
// ===========================================================================

enum ReviewStatus {
  pending
  approved
  rejected
}

model WishlistItem {
  id         String   @id @default(uuid())
  customerId String
  variantId  String
  createdAt  DateTime @default(now())

  @@unique([customerId, variantId])
  @@index([customerId])
  @@map("wishlist_items")
}

model Review {
  id               String       @id @default(uuid())
  productId        String
  customerId       String
  rating           Int
  title            String?
  body             String
  imagesJson       Json         @default("[]")
  verifiedPurchase Boolean      @default(false)
  status           ReviewStatus @default(pending)
  helpfulCount     Int          @default(0)
  createdAt        DateTime     @default(now())

  @@index([productId, status])
  @@index([customerId])
  @@map("reviews")
}

model Question {
  id         String   @id @default(uuid())
  productId  String
  customerId String
  body       String
  createdAt  DateTime @default(now())

  answers Answer[]

  @@index([productId])
  @@map("questions")
}

model Answer {
  id         String   @id @default(uuid())
  questionId String
  authorId   String
  body       String
  createdAt  DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("answers")
}

model WalletAccount {
  customerId String   @id
  balance    Int      @default(0)
  updatedAt  DateTime @updatedAt

  entries WalletEntry[]

  @@map("wallet_accounts")
}

model WalletEntry {
  id           String   @id @default(uuid())
  customerId   String
  delta        Int
  reason       String
  ref          String
  balanceAfter Int
  createdAt    DateTime @default(now())

  account WalletAccount @relation(fields: [customerId], references: [customerId], onDelete: Cascade)

  @@unique([customerId, ref])
  @@index([customerId])
  @@map("wallet_entries")
}

model Referral {
  id                 String    @id @default(uuid())
  customerId         String
  code               String    @unique
  referredCustomerId String?
  rewardedAt         DateTime?
  createdAt          DateTime  @default(now())

  @@index([customerId])
  @@map("referrals")
}

model Notification {
  id         String    @id @default(uuid())
  customerId String
  type       String
  title      String
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId, readAt])
  @@map("notifications")
}

model CmsPage {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  body      String
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("cms_pages")
}

model Banner {
  id           String    @id @default(uuid())
  placement    String
  imageUrl     String
  linkUrl      String?
  title        String?
  displayOrder Int       @default(0)
  startsAt     DateTime  @default(now())
  endsAt       DateTime?
  isActive     Boolean   @default(true)

  @@index([placement, isActive])
  @@map("banners")
}

// ===========================================================================
// U7 admin — settings + audit log
// ===========================================================================

model Setting {
  key       String   @id
  valueJson Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  target     String
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@map("admin_audit_logs")
}

// ===========================================================================
// U8.1 delivery core: in-house delivery partners, jobs, OTP
// (functional design: aidlc-docs/construction/u8-1-delivery-core/functional-design)
// ===========================================================================

enum DeliveryStatus {
  new
  assigned
  accepted
  picked_up
  out_for_delivery
  arrived
  delivered
  failed_attempt
  returned
  cancelled
}

enum DeliveryPaymentMode {
  cod
  prepaid
}

enum DeliveryAttention {
  rejected
  no_reply
  max_attempts
  payment_review
}

enum DeliveryActorKind {
  admin
  partner
  system
}

enum DeliveryAssignmentOutcome {
  pending
  accepted
  rejected
  expired
  unassigned
  reassigned
  completed
  cancelled
}

enum DeliveryOtpStatus {
  active
  verified
  expired
  superseded
  locked
}

enum DeliverySendStatus {
  pending
  sent
  failed
}

model DeliveryPartner {
  id                 String    @id @default(uuid())
  name               String
  mobile             String    @unique
  email              String?
  passwordHash       String
  mustChangePassword Boolean   @default(true)
  vehicleType        String?
  vehicleNumber      String?
  isActive           Boolean   @default(true)
  isOnline           Boolean   @default(false)
  lastSeenAt         DateTime?
  lastLat            Float?
  lastLng            Float?
  maxActiveJobs      Int       @default(10)
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  zones       DeliveryPartnerZone[]
  jobs        DeliveryJob[]
  assignments DeliveryAssignment[]

  @@index([isActive, isOnline])
  @@index([isOnline, lastSeenAt])
  @@map("delivery_partners")
}

model DeliveryZone {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  pincodes DeliveryZonePincode[]
  partners DeliveryPartnerZone[]
  jobs     DeliveryJob[]

  @@map("delivery_zones")
}

model DeliveryZonePincode {
  id      String @id @default(uuid())
  zoneId  String
  pincode String @unique

  zone DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId])
  @@map("delivery_zone_pincodes")
}

model DeliveryPartnerZone {
  partnerId String
  zoneId    String

  partner DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  zone    DeliveryZone    @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@id([partnerId, zoneId])
  @@index([zoneId])
  @@map("delivery_partner_zones")
}

model DeliveryJob {
  id                  String              @id @default(uuid())
  code                String              @unique
  orderId             String
  status              DeliveryStatus      @default(new)
  partnerId           String?
  currentAssignmentId String?
  shipmentId          String?
  attemptsUsed        Int                 @default(0)
  maxAttempts         Int
  paymentMode         DeliveryPaymentMode
  codAmount           Int                 @default(0)
  itemCount           Int
  destName            String
  destPhone           String
  destLine1           String
  destLine2           String?
  destCity            String
  destState           String
  destPincode         String
  otpPhone            String
  otpLockedUntil      DateTime?
  zoneId              String?
  trackingToken       String              @unique
  trackingExpiresAt   DateTime?
  attention           DeliveryAttention?
  acceptDeadlineAt    DateTime?
  deliveredAt         DateTime?
  endedAt             DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  order       Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  partner     DeliveryPartner?     @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  shipment    Shipment?            @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  zone        DeliveryZone?        @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  assignments DeliveryAssignment[]
  events      DeliveryEvent[]
  otps        DeliveryOtp[]

  @@index([orderId])
  @@index([partnerId, status])
  @@index([status, acceptDeadlineAt])
  @@index([status, createdAt])
  @@map("delivery_jobs")
}

model DeliveryAssignment {
  id                 String                    @id @default(uuid())
  jobId              String
  partnerId          String
  assignedByKind     DeliveryActorKind
  assignedById       String?
  assignedAt         DateTime                  @default(now())
  responseDeadlineAt DateTime?
  respondedAt        DateTime?
  outcome            DeliveryAssignmentOutcome @default(pending)
  reason             String?

  job     DeliveryJob     @relation(fields: [jobId], references: [id], onDelete: Restrict)
  partner DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@index([jobId])
  @@index([partnerId, outcome])
  @@map("delivery_assignments")
}

/// Append-only: a database trigger rejects UPDATE and DELETE (see the migration).
model DeliveryEvent {
  id         String            @id @default(uuid())
  jobId      String
  event      String
  fromStatus DeliveryStatus?
  toStatus   DeliveryStatus?
  actorKind  DeliveryActorKind
  actorId    String?
  reasonCode String?
  note       String?
  lat        Float?
  lng        Float?
  attemptNo  Int?
  meta       Json?
  createdAt  DateTime          @default(now())

  job DeliveryJob @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@index([jobId, createdAt])
  @@index([event, createdAt])
  @@map("delivery_events")
}

model DeliveryOtp {
  id           String             @id @default(uuid())
  jobId        String
  assignmentId String?
  attemptNo    Int
  phone        String
  codeHash     String
  status       DeliveryOtpStatus  @default(active)
  sendStatus   DeliverySendStatus @default(pending)
  wrongGuesses Int                @default(0)
  sendCount    Int                @default(1)
  expiresAt    DateTime
  sentAt       DateTime?
  verifiedAt   DateTime?
  createdAt    DateTime           @default(now())

  job DeliveryJob @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@index([jobId, attemptNo, createdAt])
  @@index([status, expiresAt])
  @@map("delivery_otps")
}

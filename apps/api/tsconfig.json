{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": "src",
    "outDir": "dist",
    "baseUrl": "src",
    "noUncheckedIndexedAccess": false,
    "declaration": false,
    "declarationMap": false,
    "paths": {}
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules", "test", "**/*.test.ts", "**/*.spec.ts"]
}

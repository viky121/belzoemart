{
  "name": "@belzo/api",
  "version": "0.1.0",
  "private": true,
  "description": "Belzo eMart API — NestJS modular monolith + BullMQ worker",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@belzo/shared": "workspace:*",
    "@nestjs/common": "10.3.10",
    "@nestjs/config": "3.2.3",
    "@nestjs/core": "10.3.10",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/platform-express": "10.3.10",
    "@nestjs/swagger": "7.4.0",
    "@nestjs/terminus": "10.2.3",
    "@nestjs/throttler": "6.2.1",
    "@prisma/client": "5.18.0",
    "argon2": "0.40.3",
    "bullmq": "5.12.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "cookie-parser": "1.4.6",
    "helmet": "7.1.0",
    "ioredis": "5.4.1",
    "nestjs-pino": "4.1.0",
    "nodemailer": "^10.0.10",
    "opossum": "8.1.4",
    "pdfkit": "0.20.2",
    "pino": "9.3.2",
    "pino-http": "10.2.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.2",
    "@nestjs/testing": "10.3.10",
    "@types/cookie-parser": "1.4.7",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.12",
    "@types/node": "20.14.10",
    "@types/nodemailer": "^8.0.2",
    "@types/opossum": "8.1.7",
    "@types/pdfkit": "0.17.7",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "6.0.2",
    "fast-check": "3.20.0",
    "jest": "29.7.0",
    "pino-pretty": "11.2.2",
    "prisma": "5.18.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.3",
    "ts-node": "10.9.2",
    "typescript": "5.5.4"
  }
}

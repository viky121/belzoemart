# ---------------------------------------------------------------------------
# Belzo eMart — environment configuration (copy to .env and fill values)
# NEVER commit a real .env. Production secrets come from AWS Secrets Manager.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000

# Public base URLs
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# CORS (comma-separated allowlist)
CORS_ORIGINS=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://belzo:belzo@localhost:5432/belzo?schema=public

# Redis (cache + BullMQ)
REDIS_URL=redis://localhost:6379

# Auth / JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
# Delivery module (U8): separate secret for delivery-partner tokens, and a pepper for the delivery OTP hash.
# Both min 32 chars; the partner secret must differ from the two above.
JWT_PARTNER_SECRET=change-me-partner-secret-min-32-chars-long
DELIVERY_OTP_PEPPER=change-me-delivery-otp-pepper-min-32-chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# Localization
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,hi

# Store defaults
STORE_CURRENCY=INR
STORE_GSTIN=

# Integrations — provider selection: "mock" | "live"
PAYMENT_PROVIDER=mock
SHIPPING_PROVIDER=mock
SMS_PROVIDER=mock
# Fast2SMS (used when SMS_PROVIDER=live). API key: Fast2SMS dashboard > Dev API. Never commit the real key.
# FAST2SMS_ROUTE: "otp" = Fast2SMS OTP route ("Your OTP: 123456"); "dlt" = your DLT template (needs the two ids below).
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=otp
FAST2SMS_SENDER_ID=
FAST2SMS_DLT_MESSAGE_ID=
# FAST2SMS_ROUTE=smart sends through your linked Smart OTP template; set its id here (Fast2SMS > Smart OTP).
FAST2SMS_OTP_ID=
WHATSAPP_PROVIDER=mock
EMAIL_PROVIDER=mock
STORAGE_PROVIDER=local

# Razorpay (used when PAYMENT_PROVIDER=live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ShipRocket (used when SHIPPING_PROVIDER=live)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Email (AWS SES when EMAIL_PROVIDER=live)
SES_REGION=ap-south-1
EMAIL_FROM=no-reply@belzo.example

# Object storage (S3 when STORAGE_PROVIDER=s3)
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=

# Observability
SENTRY_DSN=
LOG_LEVEL=info

# Analytics (web, public)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
